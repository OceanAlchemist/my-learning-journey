/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
struct ListNode* reverseList(struct ListNode* head) {
    struct ListNode* prev = NULL;
    struct ListNode* curr = head;
    
    while (curr != NULL) {
        struct ListNode* next = curr->next;  // 保存下一个节点
        curr->next = prev;                   // 反转指针
        prev = curr;                         // 前指针后移
        curr = next;                         // 当前指针后移
    }
    
    return prev;  // 新的头节点
}
